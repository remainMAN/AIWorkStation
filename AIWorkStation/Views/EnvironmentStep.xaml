<UserControl x:Class="AIWorkStation.Views.EnvironmentStep" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AIWorkStation.Models">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="EnvironmentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="检查电脑" Style="{StaticResource PageTitle}"/><TextBlock Text="确认 Windows、Clash 和当前网络状态。节点延迟仅供参考，不影响是否可以继续。" Style="{StaticResource PageSubtitle}" Margin="0,5,0,12"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource InfoBanner}" Margin="0,0,0,10"><DockPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,1,10,0"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/></DockPanel></Border>
        <Border Grid.Row="1" Margin="0,54,0,12">
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource WarningBanner}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Environment.Clash.Mode}" Value="rule"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Environment.Clash.Mode}" Value="Rule"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel><TextBlock Text="当前 Clash 未处于规则模式" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="程序级分流通常需要规则模式才能按进程生效，建议在 Clash Verge 中切换为“规则”。此提示不会阻止继续。" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <UniformGrid Grid.Row="2" Columns="3" Margin="-5,0,-5,10">
            <Border Style="{StaticResource Card}" Margin="5" Padding="12"><StackPanel><TextBlock Text="电脑" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/><TextBlock Text="{Binding Environment.Machine.Edition, TargetNullValue=正在检测…}" FontWeight="SemiBold"/><TextBlock Text="{Binding Environment.Machine.Architecture, StringFormat=系统架构：{0}}" Margin="0,3,0,0"/><TextBlock Text="{Binding TimeZoneSummary, StringFormat=本机时区：{0}}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="5" Padding="12"><StackPanel><TextBlock Text="Clash" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/><TextBlock Text="{Binding Environment.Clash.ClashProcess.Version, StringFormat=版本：{0}, TargetNullValue=未检测到}" FontWeight="SemiBold"/><TextBlock Text="{Binding Environment.Clash.Mode, StringFormat=运行模式：{0}, TargetNullValue=—}" Margin="0,3,0,0"/><TextBlock Margin="0,3,0,0"><Run Text="TUN："/><Run Text="{Binding Environment.Clash.TunEnabled, Converter={StaticResource BooleanToOnOffConverter}}"/></TextBlock><TextBlock Margin="0,3,0,0"><Run Text="系统代理："/><Run Text="{Binding Environment.Clash.SystemProxyEnabled, Converter={StaticResource BooleanToOnOffConverter}}"/></TextBlock></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="5" Padding="12"><StackPanel><TextBlock Text="当前网络" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/><TextBlock Text="{Binding Environment.Subscription.Name, StringFormat=当前订阅：{0}, TargetNullValue=未检测到}" FontWeight="SemiBold"/><TextBlock Text="{Binding Environment.Subscription.Nodes.Count, StringFormat=节点数量：{0}, TargetNullValue=0}" Margin="0,3,0,0"/><TextBlock Text="{Binding Environment.CurrentPublicIp, StringFormat=当前公网 IP：{0}, TargetNullValue=暂时无法获取}" Margin="0,3,0,0"/><TextBlock Text="{Binding FrontGroupSummary}" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding CurrentFrontNodeSummary}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="订阅节点" Style="{StaticResource SectionTitle}"/>
            <ListView Grid.Row="1" ItemsSource="{Binding Nodes}" MinHeight="240" AutomationProperties.Name="订阅节点列表"><ListView.View><GridView><GridViewColumn Header="节点" DisplayMemberBinding="{Binding Name}" Width="160"/><GridViewColumn Header="协议" DisplayMemberBinding="{Binding Protocol}" Width="70"/><GridViewColumn Header="服务器" DisplayMemberBinding="{Binding Server}" Width="170"/><GridViewColumn Header="服务器 IP / Fake-IP" DisplayMemberBinding="{Binding ResolvedServerIp}" Width="255"/><GridViewColumn Header="延迟" DisplayMemberBinding="{Binding LatencyDisplay}" Width="75"/><GridViewColumn Header="状态" Width="112"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding LatencyStatusDisplay, StringFormat=节点状态：{0}}"><TextBlock FontFamily="Segoe MDL2 Assets" Width="20" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE738;"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding LatencyStatus}" Value="{x:Static models:LatencyStatus.Available}"><Setter Property="Text" Value="&#xE8FB;"/><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding LatencyStatus}" Value="{x:Static models:LatencyStatus.Timeout}"><Setter Property="Text" Value="&#xE823;"/><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding LatencyStatus}" Value="{x:Static models:LatencyStatus.Failed}"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding LatencyStatus}" Value="{x:Static models:LatencyStatus.Testing}"><Setter Property="Text" Value="&#xE895;"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding LatencyStatusDisplay}" VerticalAlignment="Center"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="测试时间" DisplayMemberBinding="{Binding LatencyTestedAtDisplay}" Width="145"/></GridView></ListView.View></ListView>
            <DockPanel Grid.Row="2" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="测试全部节点" Command="{Binding TestAllNodesCommand}"/><Button Content="停止测试" Command="{Binding StopLatencyTestCommand}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="节点服务器 IP 不等于代理实际出口 IP；延迟不影响应用条件。" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentNodeLatencyNotice}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel></DockPanel>
        </Grid>
    </Grid></ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,8,0"><Button Content="重新检查" Command="{Binding RecheckCommand}"/><Button Content="下一步" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButton}" Padding="24,8"/></StackPanel>
    </Grid>
</UserControl>
