<UserControl x:Class="AIWorkStation.Views.ConfirmStep" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AIWorkStation.Models" xmlns:viewModels="clr-namespace:AIWorkStation.ViewModels">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="确认并应用" Style="{StaticResource PageTitle}"/><TextBlock Text="请核对目标软件、实际出口与连接路径。应用前会验证并备份，写入失败时会恢复原配置。" Style="{StaticResource PageSubtitle}"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="0,4,8,8">
            <Border Style="{StaticResource Card}" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="目标软件" FontWeight="SemiBold" Margin="0,9"/><TextBlock Grid.Column="1" Text="{Binding TargetSummary}" Margin="0,9" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="静态出口" FontWeight="SemiBold" Margin="0,9"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProxyServer, StringFormat=服务器：{0}}" Margin="0,9" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Text="实际公网出口" FontWeight="SemiBold" Margin="0,9"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActualExitDisplayText}" Margin="0,9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ActualExitState}" Value="{x:Static viewModels:ActualExitDisplayState.Confirmed}"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding ActualExitState}" Value="{x:Static viewModels:ActualExitDisplayState.Unavailable}"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Grid.Row="3" Text="连接方式：" FontWeight="SemiBold" Margin="0,9"/><StackPanel Grid.Row="3" Grid.Column="1" Margin="0,9"><TextBlock Text="{Binding ConnectionModeSummary, Converter={StaticResource ConnectionModeDisplayConverter}}"/><StackPanel Margin="0,6,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TransportMode}" Value="{x:Static models:StaticTransportMode.DialerProxy}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding FrontGroupSummary}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentFrontNodeSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/><TextBlock Text="目标程序 → AI 静态链 → Clash 前置线路 → 静态出口" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel></StackPanel>
                <TextBlock Grid.Row="4" Text="其他程序" FontWeight="SemiBold" Margin="0,9"/><TextBlock Grid.Row="4" Grid.Column="1" Text="保持当前网络，不受影响" Margin="0,9"/>
            </Grid></Border>
            <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0"><DockPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,1,10,0"/><StackPanel><TextBlock Text="应用过程可安全恢复" FontWeight="SemiBold"/><TextBlock Text="程序会先验证候选配置并备份原配置。若写入、重载或验证失败，将进入现有恢复流程。" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="返回修改" Command="{Binding PreviousStepCommand}"/><Button Content="正式应用" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="28,10"/></StackPanel></Grid>
    </Grid>
</UserControl>
