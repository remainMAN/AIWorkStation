<UserControl x:Class="AIWorkStation.Views.RoutingStep" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AIWorkStation.Models">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="配置分流" Style="{StaticResource PageTitle}"/><TextBlock Text="选择需要使用静态出口的软件，然后验证代理连接。" Style="{StaticResource PageSubtitle}"/></StackPanel>
        <ScrollViewer x:Name="RoutingScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ColumnsGrid" Margin="0,0,8,8" SizeChanged="ColumnsGridSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="ApplicationCard" Grid.Column="0" Style="{StaticResource Card}" Padding="18"><StackPanel>
                <TextBlock Text="目标软件" Style="{StaticResource SectionTitle}"/>
                <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OpenAI 应用" FontWeight="SemiBold"/><TextBlock Text="ChatGPT 和 Codex 共用一个静态出口" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="选择预设" Command="{Binding SelectOpenAiPresetCommand}" Style="{StaticResource PrimaryButton}"/></Grid></Border>
                <TextBlock Text="查找其他程序" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 Chrome、VS Code" AutomationProperties.Name="搜索程序"/><Button Grid.Column="1" Content="搜索" Command="{Binding SearchApplicationsCommand}"/><Button Grid.Column="2" Content="浏览 EXE" Command="{Binding BrowseExecutableCommand}" ToolTip="手动选择本地 EXE"/></Grid>
                <ListView ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" Height="100" Margin="0,8,0,0"><ListView.View><GridView><GridViewColumn Header="程序" DisplayMemberBinding="{Binding DisplayName}" Width="145"/><GridViewColumn Header="exe" DisplayMemberBinding="{Binding ExecutableName}" Width="120"/><GridViewColumn Header="来源" DisplayMemberBinding="{Binding Source}" Width="120"/></GridView></ListView.View></ListView>
                <Button Content="添加所选程序" Command="{Binding AddSelectedApplicationCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                <TextBlock Text="已选择" Style="{StaticResource FieldLabel}"/><ListBox ItemsSource="{Binding SelectedTargets}" Height="82"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource LinkButton}" Command="{Binding DataContext.RemoveApplicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=移除 {0}}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ExecutableName}" Style="{StaticResource Caption}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></Border>
            <Border x:Name="ProxyCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel>
                <TextBlock Text="静态出口" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="协议" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding ProxyProtocols}" SelectedItem="{Binding ProxyProtocol}" AutomationProperties.Name="代理协议"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理端口"/></StackPanel></Grid>
                <TextBlock Text="服务器" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProxyServer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理服务器"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户名（可选）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理用户名（可选）"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="密码" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ProxyPasswordBox" PasswordChanged="ProxyPasswordChanged" AutomationProperties.Name="代理密码"/></StackPanel></Grid>
                <CheckBox Content="在本机临时保存代理信息（24 小时）" IsChecked="{Binding SaveProxyTemporarily}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" Text="代理信息只保存在当前 Windows 用户的电脑中。&#x0a;配置生效后，必要的连接信息会保存在本地网络配置中。"/>
                <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="清除已保存信息" Command="{Binding ClearSavedInformationCommand}" Style="{StaticResource LinkButton}"/><Button Content="验证静态网络" Command="{Binding TestStaticExitCommand}" HorizontalAlignment="Stretch"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsStaticExitReady}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DockPanel>
                <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Visibility="{Binding IsStaticExitReady, Converter={StaticResource InverseBooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"><TextBlock Text="填写代理信息后进行验证。验证成功后可确认配置。" TextWrapping="Wrap"/></Border>
                <Border Style="{StaticResource SuccessBanner}" Margin="0,10,0,0" Visibility="{Binding IsStaticExitReady, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"><StackPanel><TextBlock Text="静态网络验证通过" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{Binding StaticExitSummary}" Margin="0,3,0,0"/></StackPanel></Border>
                <TextBlock Text="连接方式" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><UniformGrid Columns="3">
                    <RadioButton Content="自动（推荐）" GroupName="Transport" Style="{StaticResource SegmentRadio}" IsChecked="{Binding TransportPreference, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:StaticTransportPreference.Auto}, Mode=TwoWay}"/>
                    <RadioButton Content="直连" GroupName="Transport" Style="{StaticResource SegmentRadio}" IsChecked="{Binding TransportPreference, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:StaticTransportPreference.Direct}, Mode=TwoWay}"/>
                    <RadioButton Content="经当前 Clash 节点连接" GroupName="Transport" Style="{StaticResource SegmentRadio}" IsEnabled="{Binding DialerProxyAvailable}" IsChecked="{Binding TransportPreference, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:StaticTransportPreference.DialerProxy}, Mode=TwoWay}"/>
                </UniformGrid>
                <TextBlock Text="当前未检测到可用的 Clash 前置线路，仍可使用直连。" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="2,6,0,0" Visibility="{Binding DialerProxyAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBlock Text="链式前置线路" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding DialerProxySelections}" SelectedItem="{Binding SelectedDialerProxySelection}" DisplayMemberPath="DisplayName" IsEnabled="{Binding DialerProxyAvailable}" AutomationProperties.Name="链式前置线路"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding ConnectionModeSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding FrontGroupSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0"/><TextBlock Text="{Binding CurrentFrontNodeSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel></Border>
            </StackPanel></Border>
        </Grid></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上一步" Command="{Binding PreviousStepCommand}"/><Button Content="确认配置" Command="{Binding GoToConfirmCommand}" Padding="24,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsStaticExitReady}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid>
    </Grid>
</UserControl>
