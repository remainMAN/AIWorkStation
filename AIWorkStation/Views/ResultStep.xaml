<UserControl x:Class="AIWorkStation.Views.ResultStep" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:AIWorkStation.Models">
    <Grid>
        <Grid Visibility="{Binding IsApplying, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Height="5"/><TextBlock Text="正在应用配置" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,8"/><TextBlock Text="正在检查、生成、验证并保存配置，随后重载 Clash 并确认程序路由。请暂时不要关闭此窗口。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{Binding StatusText}" TextAlignment="Center" Margin="0,14,0,0"/></StackPanel></Grid>
        <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsApplying, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="16">
            <Border Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.Success}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.RouteVerificationNotObserved}" Value="True"><Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.RecoverySucceeded}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.FailureCode}" Value="{x:Static models:FailureCode.RecoveryFailed}"><Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE946;"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.Success}" Value="True"><Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.RouteVerificationNotObserved}" Value="True"><Setter Property="Text" Value="&#xE946;"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.RecoverySucceeded}" Value="True"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.FailureCode}" Value="{x:Static models:FailureCode.RecoveryFailed}"><Setter Property="Text" Value="&#xE711;"/><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
            <StackPanel Margin="0,14,0,0"><TextBlock Text="{Binding ResultPageTitle}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.RouteVerificationNotObserved}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.FailureCode}" Value="{x:Static models:FailureCode.RecoveryFailed}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="配置已应用" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="{Binding ApplyResult.RouteVerificationNotObserved, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="当前网络状态需要检查" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.FailureCode}" Value="{x:Static models:FailureCode.RecoveryFailed}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
            <Border Margin="0,16,0,0" Padding="16" CornerRadius="8" BorderThickness="1" AutomationProperties.LiveSetting="Polite"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource InfoBanner}"><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.Success}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.RouteVerificationNotObserved}" Value="True"><Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.FailureCode}" Value="{x:Static models:FailureCode.RecoveryFailed}"><Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/></DataTrigger><DataTrigger Binding="{Binding ApplyResult.RecoverySucceeded}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.RouteVerificationNotObserved}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding ResultMessage.MessageZh}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{Binding ResultMessage.SuggestedActionZh}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Visibility="{Binding ApplyResult.RouteVerificationNotObserved, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="暂时没有检测到目标软件的新网络请求，这不代表配置失败。" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="打开目标软件并正常使用，AIWorkStation 可以在下次检查时确认实际分流状态。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                <TextBlock Text="当前网络配置没有被修改。" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ApplyResult.Success}" Value="False"/><Condition Binding="{Binding ApplyResult.FilesModified}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="请不要继续应用配置。返回首页并检查当前网络状态，必要时查看技术详情。" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.FailureCode}" Value="{x:Static models:FailureCode.RecoveryFailed}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ResultNotice}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ApplyResult.RouteVerificationNotObserved}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="目标软件" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Column="1" Text="{Binding TargetSummary}" Margin="0,8" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="静态出口" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StaticExitSummary}" Margin="0,8"/><TextBlock Grid.Row="2" Text="连接方式" FontWeight="SemiBold" Margin="0,8"/><StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8"><TextBlock Text="{Binding ConnectionModeSummary}"/><StackPanel Margin="0,4,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TransportMode}" Value="{x:Static models:StaticTransportMode.DialerProxy}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding FrontGroupSummary}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentFrontNodeSummary}" Style="{StaticResource Caption}"/><TextBlock Text="目标程序 → AI 静态链 → Clash 前置线路 → 静态出口" Style="{StaticResource Caption}"/></StackPanel></StackPanel><TextBlock Grid.Row="3" Text="恢复结果" FontWeight="SemiBold" Margin="0,8"/><StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8"><TextBlock Text="{Binding RecoverySummary}" Visibility="{Binding ApplyResult.RecoverySucceeded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/><TextBlock Text="原来的网络配置已经恢复。" Visibility="{Binding ApplyResult.RecoverySucceeded, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Grid></Border>
            <Expander Header="查看技术详情" IsExpanded="False"><Border Background="#111827" CornerRadius="7" Padding="14" Margin="0,8"><TextBlock Foreground="#D1D5DB" FontFamily="Consolas" TextWrapping="Wrap"><Run Text="Stage: "/><Run Text="{Binding ApplyResult.Stage, Mode=OneWay}"/><LineBreak/><Run Text="FailureCode: "/><Run Text="{Binding ApplyResult.FailureCode, Mode=OneWay}"/><LineBreak/><Run Text="Detail: "/><Run Text="{Binding ApplyResult.SanitizedDetail, Mode=OneWay}"/><LineBreak/><Run Text="Recovery: "/><Run Text="{Binding RecoverySummary, Mode=OneWay}"/></TextBlock></Border></Expander>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"><Button Content="{Binding ResultReturnText}" Command="{Binding ReturnToRoutingCommand}" Visibility="{Binding CanReturnToRouting, Converter={StaticResource BooleanToVisibilityConverter}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSuccessResult}" Value="False"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="返回首页" Command="{Binding ReturnHomeCommand}"/><Button Content="完成" Click="FinishClicked" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsSuccessResult, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>
